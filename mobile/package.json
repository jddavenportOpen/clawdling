{
  "name": "clawdling-mobile",
  "version": "1.0.0",
  "description": "Clawdling for iPhone: a chat-only companion that connects to your own Clawdling server.",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/unit/*.test.ts",
    "mock": "node test/mock-server.mjs",
    "export:web": "expo export --platform web --output-dir dist-web",
    "e2e": "playwright test -c test/e2e/playwright.config.ts",
    "icons": "node scripts/make-icons.mjs",
    "store-shots": "node scripts/store-screenshots.mjs",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.38",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "~19.1.10",
    "tsx": "^4.23.0",
    "typescript": "~5.9.2"
  }
}
