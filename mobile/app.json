{
  "expo": {
    "name": "Clawdling",
    "slug": "clawdling",
    "version": "1.0.0",
    "description": "Chat with your AI agents: a chat-only companion for your own Clawdling server.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "clawdling",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d0f12",
    "primaryColor": "#9b8cff",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.jddavenport.cockpitchat",
      "appleTeamId": "TP4ZZ5XA76",
      "buildNumber": "2",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Clawdling uses the camera only to scan the pairing code that Clawdling shows on your computer.",
        "NSLocalNetworkUsageDescription": "Clawdling connects to the Clawdling server running on your own computer over your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Clawdling uses the camera only to scan the pairing code that Clawdling shows on your computer.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0f12",
          "image": "./assets/splash-icon.png",
          "imageWidth": 112
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
