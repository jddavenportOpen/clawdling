{
  "name": "clawdling",
  "version": "1.7.0",
  "description": "Your Claude Code, as a whole org: every agent on one map, who's working, who needs you, and a receipt when one says done. Runs the official claude CLI on your own plan, locally.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "bin": {
    "clawdling": "bin/clawdling.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/clawdling.js start",
    "test": "node test/run.mjs",
    "test:unit": "node test/run.mjs unit",
    "test:integration": "node test/run.mjs integration",
    "e2e": "playwright test -c test/e2e/playwright.config.js",
    "smoke:live": "node test/live/smoke-live.mjs",
    "test:tmux": "node test/run.mjs all --backend tmux",
    "test:pty": "node test/run.mjs all --backend pty"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "htm": "^3.1.1",
    "preact": "^11.0.1",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  },
  "files": [
    "bin",
    "server",
    "templates",
    "web",
    "README.md",
    "SETUP.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "claude-code",
    "agents",
    "cockpit",
    "tmux",
    "personal-ai",
    "chief-of-staff",
    "telegram",
    "imessage",
    "windows",
    "node-pty"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jddavenportOpen/clawdling.git"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
