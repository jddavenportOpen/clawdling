{
  "name": "clawdling",
  "version": "1.0.0",
  "description": "Turn Claude Code into an org of agents: a visual cockpit, domain and project agents with memory, and a chief of staff you can text. Installed by handing Claude Code one link.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "bin": {
    "clawdling": "bin/clawdling.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/clawdling.js start",
    "test": "node --test --test-concurrency=1 test/unit/*.test.js test/integration/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "e2e": "playwright test -c test/e2e/playwright.config.js",
    "smoke:live": "node test/live/smoke-live.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "htm": "^3.1.1",
    "preact": "^11.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  },
  "files": [
    "bin",
    "server",
    "templates",
    "web",
    "README.md",
    "SETUP.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "claude-code",
    "agents",
    "cockpit",
    "tmux",
    "personal-ai",
    "chief-of-staff",
    "telegram",
    "imessage"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jddavenportOpen/clawdling.git"
  }
}
