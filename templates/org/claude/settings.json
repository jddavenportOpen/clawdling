{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(clawdling ls)",
      "Bash(clawdling ls *)",
      "Bash(clawdling spawn *)",
      "Bash(clawdling send *)",
      "Bash(clawdling new *)",
      "Bash(clawdling discover)",
      "Bash(clawdling discover *)",
      "Bash(clawdling end *)",
      "Bash(clawdling doctor)",
      "Bash(clawdling remote list)",
      "Bash(clawdling remote serve-status)"
    ],
    "deny": [
      "Read(/.clawdling/**)",
      "Edit(/.clawdling/**)"
    ]
  }
}
