{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(clawdling report)",
      "Bash(clawdling report *)",
      "Bash(clawdling ls)",
      "Bash(clawdling ls *)",
      "Read({{cto}}/**)",
      "Write({{cto}}/reviews/**)",
      "Edit({{cto}}/reviews/**)"
    ],
    "ask": [
      "Bash(clawdling send *)",
      "Bash(clawdling spawn *)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Write({{cto}}/CLAUDE.md)",
      "Edit({{cto}}/CLAUDE.md)",
      "Write({{cto}}/.claude/**)",
      "Edit({{cto}}/.claude/**)"
    ]
  }
}
