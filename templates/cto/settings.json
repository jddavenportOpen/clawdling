{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(clawdling report --all --json --window 7d)",
      "Bash(clawdling report --all --json)",
      "Bash(clawdling ls --json)",
      "Bash(clawdling ls)",
      "Read({{cto}}/**)",
      "Write({{cto}}/reviews/*.md)",
      "Edit({{cto}}/reviews/*.md)"
    ],
    "ask": [
      "Bash(clawdling send *)",
      "Bash(clawdling spawn *)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Agent",
      "Task",
      "SendMessage",
      "RemoteTrigger",
      "CronCreate",
      "ScheduleWakeup",
      "Write({{cto}}/CLAUDE.md)",
      "Edit({{cto}}/CLAUDE.md)",
      "Write({{cto}}/.claude/**)",
      "Edit({{cto}}/.claude/**)"
    ]
  }
}
