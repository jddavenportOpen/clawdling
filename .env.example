# Clawdling — environment template.
# Self-host: install.sh copies this to .env and prompts for the one REQUIRED value.
# No em dashes by house rule.

# ============================================================
# REQUIRED (both flows) — the engine
# ============================================================
# Your Anthropic Console API key (sk-ant-api03-...). Every model call meters
# against it. This is the ONLY value a self-hoster must supply to start.
ANTHROPIC_API_KEY=

# Engine mode: "sdk" (default, uses ANTHROPIC_API_KEY) or "cli" (self-host only,
# uses your own Claude Code / Max subscription on your own machine — personal use
# only, no resale, per Anthropic's Terms of Service).
ADJUTANT_ENGINE=sdk

# Profile: which bundle under profiles/ supplies the cockpit's domains + agent
# prompts. Ships with "starter" (Work / Personal / Notes). Edit
# profiles/starter/domains.yaml to make it yours.
ADJUTANT_PROFILE=starter

# Active tools (comma list). Defaults to "web,tasks,memory" when unset, so the
# core acting tools are ON out of the box (the assistant can create_task /
# list_tasks / complete_task / remember / recall from your first message). "web"
# = Anthropic web search + fetch. "google" (Gmail/Calendar) is OFF by default
# and needs a Google OAuth client you supply. Set empty for a chat-only bot.
ADJUTANT_TOOLS=web,tasks,memory

# ============================================================
# STATE BACKEND — where your data lives
# ============================================================
# "local" = local JSON files under ADJUTANT_STATE_ROOT, zero cloud accounts
# (self-host default). "supabase" = hosted Postgres (hosted product).
ADJUTANT_STATE=local

# One state root for all local data. Defaults under the repo.
ADJUTANT_STATE_ROOT=./.adjutant

# Supabase (only when ADJUTANT_STATE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ============================================================
# AUTH — how you sign in
# ============================================================
# "magic-link" (email) for hosted/multi-user. "single" for a local self-host
# instance where the one operator is implicitly trusted (no email server needed).
ADJUTANT_AUTH=single
# Cosmetic: the email shown for the local user in single mode.
ADJUTANT_LOCAL_EMAIL=local@adjutant.localhost
# Required by NextAuth's module init even in single mode (auth flow is bypassed).
# install.sh generates one; set any random 32+ byte string. openssl rand -base64 32
NEXTAUTH_SECRET=
# Magic-link email delivery (only when ADJUTANT_AUTH=magic-link)
EMAIL_SERVER=
EMAIL_FROM=
RESEND_API_KEY=

# ============================================================
# BRIDGE — the local PTY service that runs your Claude Code panes
# ============================================================
# Only needed for the multi-pane cockpit (`make bridge`). The plain
# BYOK chat works without it.
#
# BRIDGE_SECRET is the shared HMAC secret. It MUST be identical here and in
# the bridge's environment, and it must not be guessable. Generate one:
#   openssl rand -hex 32
BRIDGE_URL=http://localhost:8787
BRIDGE_SECRET=

# Pane stream transport. MUST be `get` for this build: SessionTerminal defaults
# to a POST transport that expects a /stream-post route which does not exist
# here, so leaving this unset makes every pane fail to connect. The GET/
# EventSource path is the correct one for a local single-user bridge anyway.
NEXT_PUBLIC_BRIDGE_STREAM_METHOD=get

# Where panes are allowed to run. A spawn whose cwd resolves outside this
# root is refused.
CLAWDLING_WORKSPACE_ROOT=~/clawdling-workspaces
# Max concurrent panes.
CLAWDLING_MAX_SESSIONS=12
# The Claude Code binary the bridge drives.
CLAWDLING_CLAUDE_BIN=claude

# Reaching the cockpit from your phone: the browser streams pane output
# DIRECTLY from the bridge, so BRIDGE_URL must be reachable from the phone
# too, not just from the machine running Next. Set it to the bridge's public
# tunnel origin. See docs/REMOTE-ACCESS.md.

# ============================================================
# GOOGLE (optional) — Gmail + Calendar. Skip to run without them.
# Self-host/alpha: bring your own Google Cloud OAuth client.
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# BRIDGE - the Python PTY bridge (cockpit panes run the claude CLI)
# ============================================================
# Where the bridge listens. The cockpit calls it server-side; the browser also
# opens the SSE stream at this URL directly.
BRIDGE_URL=http://localhost:8787
# Shared HS256 secret. The bridge REFUSES to boot without a real one (32+ chars,
# no placeholders). Generate: openssl rand -base64 32
# Set the SAME value here and in the environment you run `make bridge` in.
BRIDGE_SECRET=
# Every session cwd must resolve inside this directory.
CLAWDLING_WORKSPACE_ROOT=~/clawdling-workspaces
# Max concurrent live panes.
CLAWDLING_MAX_SESSIONS=12
# The binary the bridge execs. Point at a script to try it without spending.
CLAWDLING_CLAUDE_BIN=claude
