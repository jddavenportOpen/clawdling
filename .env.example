# Clawdling — environment template.
# Self-host: install.sh copies this to .env and prompts for the one REQUIRED value.
# No em dashes by house rule.

# ============================================================
# REQUIRED (both flows) — the engine
# ============================================================
# Your Anthropic Console API key (sk-ant-api03-...). Every model call meters
# against it. This is the ONLY value a self-hoster must supply to start.
ANTHROPIC_API_KEY=

# Chat engine. "sdk" calls the Anthropic API with ANTHROPIC_API_KEY and is
# the only chat engine in this build. (The Claude Code panes do not use it:
# they run the `claude` CLI signed in with your own Claude plan.)
ADJUTANT_ENGINE=sdk
# 1 = chat streams a canned reply and spends nothing (a demo with no key).
ADJUTANT_MOCK=

# Profile: which bundle under profiles/ supplies the cockpit's domains + agent
# prompts. Ships with "starter" (Work / Personal / Notes). Edit
# profiles/starter/domains.yaml to make it yours.
ADJUTANT_PROFILE=starter

# Active tools (comma list). Defaults to "web,tasks,memory" when unset, so the
# core acting tools are ON out of the box (the assistant can create_task /
# list_tasks / complete_task / remember / recall from your first message). "web"
# = Anthropic web search + fetch. "google" (Gmail/Calendar) is OFF by default
# and needs a Google OAuth client you supply. Set empty for a chat-only bot.
ADJUTANT_TOOLS=web,tasks,memory

# ============================================================
# STATE BACKEND — where your data lives
# ============================================================
# "local" = local JSON files under ADJUTANT_STATE_ROOT, zero cloud accounts
# (self-host default). "supabase" = hosted Postgres (hosted product).
ADJUTANT_STATE=local

# One state root for all local data. Defaults under the repo.
ADJUTANT_STATE_ROOT=./.adjutant

# Supabase (only when ADJUTANT_STATE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ============================================================
# AUTH — how you sign in
# ============================================================
# "magic-link" (email) for hosted/multi-user. "single" for a local self-host
# instance where the one operator is implicitly trusted (no email server needed).
ADJUTANT_AUTH=single
# Cosmetic: the email shown for the local user in single mode.
ADJUTANT_LOCAL_EMAIL=local@adjutant.localhost
# Required by NextAuth's module init even in single mode (auth flow is bypassed).
# install.sh generates one; set any random 32+ byte string. openssl rand -base64 32
NEXTAUTH_SECRET=
# Magic-link email delivery (only when ADJUTANT_AUTH=magic-link)
EMAIL_SERVER=
EMAIL_FROM=
RESEND_API_KEY=

# ============================================================
# BRIDGE — the local PTY service that runs your Claude Code panes
# ============================================================
# Only needed for the multi-pane cockpit (`make bridge`). The plain
# BYOK chat works without it.
#
# Where the cockpit reaches the bridge; the browser also opens the pane
# stream here directly. `make bridge` listens on this URL's port.
BRIDGE_URL=http://localhost:8787
# Shared HS256 secret between the cockpit and the bridge. install.sh writes a
# random one here, and `make bridge` reads it from this same file, so there
# is nothing to copy. The bridge refuses to boot on a weak one (under 32
# chars, or a placeholder). To make your own: openssl rand -hex 32
BRIDGE_SECRET=

# Pane stream transport. MUST be `get` for this build: SessionTerminal defaults
# to a POST transport that expects a /stream-post route which does not exist
# here, so leaving this unset makes every pane fail to connect. The GET/
# EventSource path is the correct one for a local single-user bridge anyway.
NEXT_PUBLIC_BRIDGE_STREAM_METHOD=get

# Where panes are allowed to run. A spawn whose cwd resolves outside this
# root is refused.
CLAWDLING_WORKSPACE_ROOT=~/clawdling-workspaces
# Max concurrent panes.
CLAWDLING_MAX_SESSIONS=12
# The Claude Code binary the bridge drives. Point at a script to try the
# cockpit without spending.
CLAWDLING_CLAUDE_BIN=claude

# Reaching the cockpit from your phone: the browser streams pane output
# DIRECTLY from the bridge, so BRIDGE_URL must be reachable from the phone
# too, not just from the machine running Next. Set it to the bridge's public
# tunnel origin. See docs/REMOTE-ACCESS.md.

# ============================================================
# GOOGLE (optional) — Gmail + Calendar. Skip to run without them.
# Self-host/alpha: bring your own Google Cloud OAuth client.
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# VOICE (optional) - hold-to-record mic in the composer.
# Leave unset and voice is simply unavailable: the mic button still
# renders, and a recording returns a clear "not configured" error
# instead of failing silently. Nothing else in the app needs this.
# ============================================================
# Anthropic has NO speech-to-text API, so transcription is the one
# capability your Anthropic key cannot cover. Pick a provider:
#
#   local  = your own machine, no second account, no extra bill.
#            Works with any OpenAI-compatible server: whisper.cpp
#            (whisper-server), faster-whisper-server, LM Studio.
#   openai = OpenAI's hosted audio endpoint. Needs OPENAI_API_KEY.
#
# Unset or unsupported values are refused with a message naming the
# vars to set. Audio is streamed straight to the provider and is
# never written to disk.
TRANSCRIBE_PROVIDER=

# Required when TRANSCRIBE_PROVIDER=local. A bare origin gets
# /v1/audio/transcriptions appended; a URL with a path is used as
# given (e.g. http://127.0.0.1:8080/inference).
TRANSCRIBE_URL=

# Required when TRANSCRIBE_PROVIDER=openai.
OPENAI_API_KEY=

# Optional. The model name sent to the provider. Defaults to
# whisper-1. Local servers generally ignore it and use whatever
# model they loaded at startup.
TRANSCRIBE_MODEL=

# ============================================================
# WORKERS - background runs dispatched through the same bridge
# ============================================================
# A pane is a conversation you sit in; a worker is a job you hand off. It runs
# headless in its own git worktree with a wall-clock ceiling and reports when
# it is done. Needs the bridge (above) and the Claude Code CLI.
#
# Concurrent RUNNING workers. Finished runs stay listed and free their slot.
CLAWDLING_MAX_WORKERS=4
# Default wall-clock ceiling in seconds (30 min). A dispatch may ask for more,
# up to 24h. An unattended process with no deadline is a leak.
CLAWDLING_WORKER_MAX_RUNTIME=1800
# Where worker logs and worktrees live. Defaults to
# $CLAWDLING_WORKSPACE_ROOT/.clawdling-workers. If your workspace root is itself
# a git repo, add that directory to its .gitignore.
CLAWDLING_WORKER_ROOT=
# The git binary used to create and remove worker worktrees.
CLAWDLING_GIT_BIN=git
# --- Transcript persistence (pane history survives a bridge restart) -------
# Where per-session transcripts live. Deliberately NOT under the workspace
# root: every pane's cwd is inside that tree, so a transcript kept there would
# be a file the agent could rewrite.
CLAWDLING_STATE_ROOT=~/.clawdling
# 0 turns persistence off entirely (scrollback stays in memory only).
CLAWDLING_TRANSCRIPTS=1
# How much of a transcript a reattach or /history call replays, in bytes.
CLAWDLING_HISTORY_TAIL_BYTES=262144
# Per-session cap. Over this, the OLDEST bytes are dropped; byte cursors stay
# monotonic across the trim.
CLAWDLING_TRANSCRIPT_MAX_FILE_BYTES=33554432
# Retention, enforced on boot. Either cap may be 0 to disable that half.
CLAWDLING_TRANSCRIPT_RETENTION=200
CLAWDLING_TRANSCRIPT_MAX_AGE_DAYS=14
# Pass --session-id on spawn (and --resume when continuing a prior session) so
# the MODEL's context comes back, not just the text. Set 0 if CLAWDLING_CLAUDE_BIN
# is a stub that does not understand those flags.
CLAWDLING_RESUME=1
